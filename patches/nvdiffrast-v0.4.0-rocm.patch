+// __frcp_rz: reciprocal rounded toward zero. Correctly rounded 1/x, then step toward zero if it overshot.
+static __device__ __forceinline__ float __frcp_rz(float x)
+{
+    float r = __frcp_rn(x);
+    if (isfinite(r) && r != 0.f && fmaf(-r, x, 1.0f) < 0.f) r = nextafterf(r, 0.f);
