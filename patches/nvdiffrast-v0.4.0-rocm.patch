diff --git a/csrc/common/cr_warp32.h b/csrc/common/cr_warp32.h
new file mode 100644
index 0000000..19cba20
--- /dev/null
+++ b/csrc/common/cr_warp32.h
@@ -0,0 +1,61 @@
+// ROCm port: 32-lane logical warps on 64-lane (CDNA) or 32-lane (RDNA) hardware wavefronts.
+//
+// The cudaraster / nvdiffrast kernels are written for 32-thread warps laid out as blockDim = (32, numWarps).
+// On wave64 hardware one wavefront holds two such logical warps (threadIdx.y = 2k, 2k+1). Every warp-level
+// primitive below acts only on the 32-lane half that the calling lane belongs to, so the two logical warps
+// sharing a wavefront never see each other's lanes. On wave32 hardware the half offset is always 0.
+#pragma once
+
+#if defined(__HIP_PLATFORM_AMD__) || defined(USE_ROCM)
+#include <hip/hip_runtime.h>
+#if defined(__HIPCC__)  // device helpers only; host-compiled .cpp files never use them
+
+__device__ __forceinline__ unsigned cr_lane32(void) { return __lane_id() & 31u; }
+__device__ __forceinline__ unsigned cr_half_base(void) { return __lane_id() & ~31u; }
+
+// 32-bit ballot over the caller's logical warp (inactive lanes contribute 0, as in CUDA).
+__device__ __forceinline__ unsigned cr_ballot32(int pred)
+{
+    unsigned long long b = __ballot(pred);
+    return (unsigned)(b >> cr_half_base());
+}
+__device__ __forceinline__ bool cr_any32(int pred) { return cr_ballot32(pred) != 0u; }
+__device__ __forceinline__ bool cr_all32(int pred) { return cr_ballot32(!pred) == 0u; }
+
+// width=32 shuffles stay inside the 32-lane half.
+template <class T> __device__ __forceinline__ T cr_shfl32(T v, int src) { return __shfl(v, src, 32); }
+template <class T> __device__ __forceinline__ T cr_shfl_xor32(T v, int m) { return __shfl_xor(v, m, 32); }
+template <class T> __device__ __forceinline__ T cr_shfl_up32(T v, unsigned d) { return __shfl_up(v, d, 32); }
+template <class T> __device__ __forceinline__ T cr_shfl_down32(T v, unsigned d) { return __shfl_down(v, d, 32); }
+
+// Lanes of a wavefront execute in lockstep; the fences keep the compiler from moving shared-memory
+// accesses across the point where CUDA code expects warp-level visibility.
+__device__ __forceinline__ void cr_syncwarp(void)
+{
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "wavefront");
+    __builtin_amdgcn_wave_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "wavefront");
+}
+
+#define CR_BALLOT(mask, pred)       cr_ballot32(pred)
+#define CR_ANY(mask, pred)          cr_any32(pred)
+#define CR_ALL(mask, pred)          cr_all32(pred)
+#define CR_SHFL(mask, v, src)       cr_shfl32((v), (src))
+#define CR_SHFL_XOR(mask, v, m)     cr_shfl_xor32((v), (m))
+#define CR_SHFL_UP(mask, v, d)      cr_shfl_up32((v), (d))
+#define CR_SHFL_DOWN(mask, v, d)    cr_shfl_down32((v), (d))
+#define CR_SYNCWARP(...)            cr_syncwarp()
+#endif  // __HIPCC__
+
+#else  // CUDA
+
+#define CR_BALLOT(mask, pred)       __ballot_sync((mask), (pred))
+#define CR_ANY(mask, pred)          __any_sync((mask), (pred))
+#define CR_ALL(mask, pred)          __all_sync((mask), (pred))
+#define CR_SHFL(mask, v, src)       __shfl_sync((mask), (v), (src))
+#define CR_SHFL_XOR(mask, v, m)     __shfl_xor_sync((mask), (v), (m))
+#define CR_SHFL_UP(mask, v, d)      __shfl_up_sync((mask), (v), (d))
+#define CR_SHFL_DOWN(mask, v, d)    __shfl_down_sync((mask), (v), (d))
+#define CR_SYNCWARP(...)            __syncwarp(__VA_ARGS__)
+
+#endif
