+// Lexicographic (x, y, z) key sort without cub's tuple decomposer (unavailable in hipCUB):
+// three stable LSD radix passes (z, then y, then x) give the same permutation as the decomposer sort.
+static __global__ void gather_face_component_kernel(const int3* faces, const int* perm, int comp, int F, int* out) {
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F) return;
+    int3 f = faces[perm[tid]];
+    out[tid] = comp == 0 ? f.x : (comp == 1 ? f.y : f.z);
+}
+static __global__ void gather_faces_kernel(const int3* faces, const int* perm, int F, int3* out) {
+    int tid = blockIdx.x * blockDim.x + threadIdx.x;
+    if (tid >= F) return;
+    out[tid] = faces[perm[tid]];
+}
 
 
