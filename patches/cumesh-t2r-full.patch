diff --git a/src/t2r_alloc.h b/src/t2r_alloc.h
new file mode 100644
index 0000000..0d1de42
--- /dev/null
+++ b/src/t2r_alloc.h
@@ -0,0 +1,18 @@
+// t2r build of CuMesh: route device allocations through PyTorch's HIP caching allocator. CuMesh allocates and frees
+// scratch buffers inside every simplify / chart / remesh iteration, and hipMalloc/hipFree are synchronous and slow on
+// ROCm. Allocation does not affect any arithmetic, so results are unchanged.
+#pragma once
+#if defined(__HIP_PLATFORM_AMD__) || defined(USE_ROCM)
+#include <hip/hip_runtime.h>
+#include <c10/hip/HIPCachingAllocator.h>
+static inline hipError_t t2r_hip_malloc(void** p, size_t n) {
+  *p = n ? c10::cuda::CUDACachingAllocator::raw_alloc(n) : nullptr;
+  return hipSuccess;
+}
+static inline hipError_t t2r_hip_free(void* p) {
+  if (p) c10::cuda::CUDACachingAllocator::raw_delete(p);
+  return hipSuccess;
+}
+#define hipMalloc(p, n) t2r_hip_malloc((void**)(p), (n))
+#define hipFree(p) t2r_hip_free((void*)(p))
+#endif
diff --git a/src/utils.h b/src/utils.h
index aeaf2d8..98fd1fd 100644
--- a/src/utils.h
+++ b/src/utils.h
@@ -26,6 +26,14 @@ namespace cumesh {
 /**
  * A GPU buffer class that manages device memory.
  */
+#if defined(__CUDACC__) || defined(__HIPCC__)
+template <typename T>
+__global__ void t2r_fill_kernel(T* p, size_t n, T v) {
+    size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) p[i] = v;
+}
+#endif
+
 template<typename T>
 struct Buffer {
     T* ptr;
@@ -84,9 +92,16 @@ struct Buffer {
 
     void fill(T val) {
         cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+#if defined(__CUDACC__) || defined(__HIPCC__)
+        // t2r: fill on the device (upstream builds a host vector of `size` elements and does a synchronous pageable
+        // host-to-device copy on every call, ~300 MB per call on large meshes).
+        if (size) t2r_fill_kernel<T><<<(unsigned)((size + 255) / 256), 256, 0, stream>>>(ptr, size, val);
+        CUDA_CHECK(cudaGetLastError());
+#else
         std::vector<T> tmp(size, val);
         CUDA_CHECK(cudaMemcpyAsync(ptr, tmp.data(), size * sizeof(T), cudaMemcpyHostToDevice, stream));
         CUDA_CHECK(cudaStreamSynchronize(stream));
+#endif
     }
 };
 
